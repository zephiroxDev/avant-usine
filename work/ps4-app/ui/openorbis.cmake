set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "$ENV{OO_PS4_TOOLCHAIN}")
set(CMAKE_C_FLAGS_INIT "-D_GNU_SOURCE -fPIC -funwind-tables -fstack-usage -isystem $ENV{OO_PS4_TOOLCHAIN}/include")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -isystem $ENV{OO_PS4_TOOLCHAIN}/include/c++/v1")
